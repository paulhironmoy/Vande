{
  "name": "vande",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "VANDE Cricket: offline first-person batting Practice for Android and the web, with exact-ball retry and coaching that comes from the physics.",
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.22.2 || >=23.6"
  },
  "scripts": {
    "dev": "vite",
    "dev:unity": "VITE_UNITY_PRACTICE_WEB=1 VITE_UNITY_PRACTICE_ENGINEERING_PREVIEW=1 vite",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "typecheck:all": "npm run typecheck && tsc -p backend/tsconfig.json --noEmit && tsc -p render-service/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "build": "npm run typecheck && vite build",
    "build:unity": "npm run typecheck && VITE_UNITY_PRACTICE_WEB=1 VITE_UNITY_PRACTICE_ENGINEERING_PREVIEW=1 vite build --outDir dist-unity-preview",
    "build:pages": "npm run typecheck && BASE_PATH=/Vande/ vite build --outDir dist-pages",
    "preview": "vite preview --port 4173 --strictPort",
    "preview:unity": "VITE_UNITY_PRACTICE_WEB=1 VITE_UNITY_PRACTICE_ENGINEERING_PREVIEW=1 vite preview --outDir dist-unity-preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:flow": "FLOW=1 playwright test",
    "test:render": "vitest run --config render-service/vitest.config.ts",
    "scripts:test": "node scripts/run-script-tests.mjs",
    "textures:test": "node --test scripts/unity-textures/generate.test.mjs",
    "motion:test": "node --test scripts/motion/*.test.mjs",
    "motion:check": "node scripts/motion/export.mjs --check",
    "motion:test:py": "python3 -B -m unittest discover -s scripts/blender/motion -p '*_test.py'",
    "practice:goldens:check": "node scripts/practice-unity-goldens.mjs --check",
    "audio:tools:test": "node --test scripts/audio/dsp.test.mjs scripts/audio/sidecar.test.mjs scripts/audio/freesound-search.test.mjs scripts/audio/placeholders.test.mjs scripts/audio/ingest-recordings.test.mjs",
    "audio:tools:test:portable": "node --test scripts/audio/dsp.test.mjs scripts/audio/sidecar.test.mjs",
    "test:capture-compare": "vitest run tests/unit/evaluation/capture-compare.test.ts tests/unit/evaluation/capture-compare-adversarial.test.ts tests/unit/evaluation/capture-compare-normalize.test.ts",
    "test:all": "npm run test && npm run scripts:test && npm run build && npm run test:e2e",
    "assets": "node scripts/brand/build.mjs",
    "notices": "node scripts/generate-notices.mjs --android",
    "android:sync": "VITE_BUILD_TARGET=android npm run build && cap sync android",
    "android:apk:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:policy:test": "node --test scripts/android-adb-endpoint.test.mjs scripts/android-evidence.test.mjs scripts/check-android-size.test.mjs scripts/check-android-release-compat.test.mjs scripts/check-unity-r8.test.mjs scripts/verify-unity-webgl.test.mjs scripts/unity-preview-scripts.test.mjs",
    "android:release": "scripts/build-android.sh",
    "android:preview": "scripts/build-android.sh --preview",
    "android:lifecycle": "scripts/android-lifecycle.sh",
    "android:open": "cap open android",
    "eval:capture:web": "node scripts/eval/compare/capture-web.mjs",
    "eval:capture:webgl": "node scripts/eval/compare/capture-webgl.mjs",
    "eval:capture:android": "node scripts/eval/compare/capture-android.mjs",
    "eval:capture:normalize": "node scripts/eval/compare/normalize.mjs",
    "eval:capture:annotate": "node scripts/eval/compare/annotate.mjs",
    "eval:capture:metrics": "node scripts/eval/compare/metrics.mjs",
    "eval:capture:compare": "node scripts/eval/compare/compare.mjs",
    "eval:gate-a:still": "node scripts/eval/compare/gate-a-still.mjs",
    "eval:capture:replay-v3": "node docs/evaluation/capture-compare/reviews/retest-v3/replay-v3.mjs",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "sim": "node scripts/simulate-balance.mjs",
    "sim:golden": "node scripts/simulate-golden.mjs",
    "sim:ranking": "node scripts/simulate-ranking.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/screen-orientation": "8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.186.1",
    "uqr": "0.1.3",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@cloudflare/workers-types": "^5.20261024.1",
    "@eslint/js": "10.0.1",
    "@fontsource/manrope": "5.2.8",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "^6.2.6",
    "fflate": "^0.8.3",
    "fontkit": "2.0.4",
    "globals": "17.13.0",
    "jsdom": "^30.1.3",
    "meshoptimizer": "1.1.1",
    "playwright": "^1.64.1",
    "prettier": "3.9.10",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "yauzl": "^2.10.0"
  }
}

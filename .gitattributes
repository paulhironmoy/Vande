# Line endings: text is LF in the repository and in the working tree (see .editorconfig).
# `text=auto` leaves a file that already holds CRLF in the index alone, so adding this file changes nothing that is
# committed; it only keeps new files LF.
* text=auto eol=lf

# Windows batch files need CRLF in the working tree. (`text=auto`, not `text`: an explicit `text` would report the
# CRLF file that is already committed as modified.)
*.bat text=auto eol=crlf

# Binary files: never converted, diffed or merged.
*.png binary
*.jpg binary
*.webp binary
*.ttf binary
*.woff2 binary
*.mp3 binary
*.ogg binary
*.glb binary
*.jar binary
# Motion packs (web .vmp, Unity .bytes) and the other Unity .bytes assets.
*.vmp binary
*.bytes binary

# Unity serialises scenes, prefabs, assets, materials and .meta files as YAML text (Force Text). They stay text and
# LF through the rule above; do not mark them binary.

# Generated files: collapsed in review, regenerated by the named command and checked in CI.
# Motion packs: node scripts/motion/export.mjs (check: npm run motion:check).
public/practice/motion/*.vmp binary linguist-generated
unity/VandePractice/Assets/VandePractice/Runtime/Presentation/Resources/Motion/*.bytes binary linguist-generated
# Practice golden fixtures: node scripts/practice-unity-goldens.mjs (check: npm run practice:goldens:check).
tests/fixtures/unity-practice/*.json linguist-generated
# Third-party notices: npm run notices. The licence texts inside keep their own line endings (the file mixes LF and
# CRLF), so Git never converts it.
public/third-party-notices.txt -text linguist-generated

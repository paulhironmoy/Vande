# VANDE — build-time configuration. Copy to .env.local (gitignored) and fill in only what you use.
# Every value below is OPTIONAL. With none of them set, `npm run build` produces a fully local, zero-cost app:
# no community results, no analytics, no network requests beyond the app's own files.

# --- Community results (anonymous aggregates; see docs/BACKEND.md) ---------------------------------
# Base URL of the deployed Cloudflare Worker. Empty = feature disabled.
VITE_COMMUNITY_API_URL=
# Kill switch: '1' disables submissions and stats even when the URL is set.
VITE_KILL_COMMUNITY=

# --- Product analytics (see docs/ANALYTICS.md) -----------------------------------------------------
# 'none' (default) or 'posthog'. Analytics stay off until provider, host and key are all set.
VITE_ANALYTICS_PROVIDER=none
VITE_POSTHOG_HOST=
VITE_POSTHOG_KEY=
# Kill switch: '1' disables analytics even when configured.
VITE_KILL_ANALYTICS=

# --- Reminders ---------------------------------------------------------------------------------------
# 'off' hides the optional local reminder feature (default on; reminders themselves are off per player).
VITE_REMINDERS=

# --- Lite experiments ----------------------------------------------------------------------------------
# '1' turns on the trade-results experiment (default off): after answering a dare, "who won" unlocks only once the
# friend sends their result back. Their own score and the full reveal always show at once.
VITE_LITE_TRADE_RESULTS=
# '1' turns on verified dares (default off): the friend's twist is drawn and graded by the community API and the reply
# is signed. Needs VITE_COMMUNITY_API_URL and VITE_DARE_PUBLIC_KEY; players must also opt in to community sharing.
VITE_LITE_VERIFIED_DARES=
# Public key that checks verified-dare signatures offline (04 + 128 hex). Print a pair with:
#   node scripts/lite-dare-keys.mjs
# The private half goes only into the Worker secret DARE_SIGNING_KEY, never into this file.
VITE_DARE_PUBLIC_KEY=
# Optional extra public keys (comma separated), e.g. the old and the new key during a rotation (docs/ROLLBACK.md).
VITE_DARE_PUBLIC_KEYS=

# --- Backend (backend/wrangler.toml [vars]; secrets via `wrangler secret put`) -------------------
# ALLOWED_ORIGINS=https://paulhironmoy.github.io,https://localhost,capacitor://localhost
# MIN_COHORT=25
# CONTENT_VERSIONS=
# RATE_LIMIT_PER_MINUTE=30
# RATE_SALT=<secret: `wrangler secret put RATE_SALT`, never commit>
# DARE_SIGNING_KEY=<secret: `wrangler secret put DARE_SIGNING_KEY` (P-256 private JWK), never commit>
# LITE_VERIFY_REPLAY=0        # '1' replays dares before signing; needs Workers Paid (late questions use ~20 ms CPU)
# KILL_LITE_DARES=0           # '1' switches the verified-dare endpoints off (503) without removing the secret
# RATE_LIMIT_DARES_PER_MINUTE=60

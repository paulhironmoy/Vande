{
  "name": "vande-render-service",
  "version": "0.1.0",
  "private": true,
  "description": "Renders official VANDE Cricket highlight Shorts from verified replays (Cloud Run job): headless Chromium + ffmpeg.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "node --experimental-strip-types --no-warnings src/main.ts",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "playwright-core": "1.64.1"
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vande.app/schema/lite-twists.schema.json",
  "title": "VANDE Lite twist pool",
  "description": "Twist questions for Lite dares: a new short situation built on the same idea as the dared move. Ids are permanent; retire instead of deleting. Machine checks beyond this schema live in src/lite/twistValidate.ts (word limits, single best, kind matches the best option's tags, denylist).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "twists"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "twists": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/twist"
      }
    }
  },
  "definitions": {
    "actionTag": {
      "enum": [
        "proportionate",
        "disproportionate",
        "suppressive",
        "force",
        "detention",
        "accusation",
        "transparent",
        "investigative",
        "dialogue",
        "service",
        "communication",
        "legal-process",
        "protect-press",
        "protect-assembly",
        "wait",
        "censorship",
        "relief"
      ]
    },
    "kind": {
      "enum": [
        "talk",
        "check",
        "protect",
        "enforce",
        "restrict",
        "wait",
        "rule"
      ]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "enum": [
            "a",
            "b",
            "c",
            "d"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/actionTag"
          }
        }
      }
    },
    "twist": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "situation",
        "options",
        "best",
        "why"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^t([1-9][0-9]{0,2}|1[01][0-9]{2}|12[0-8][0-9]|129[0-5])$"
        },
        "kind": {
          "$ref": "#/definitions/kind"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "situation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "options": {
          "type": "array",
          "minItems": 3,
          "maxItems": 4,
          "items": {
            "$ref": "#/definitions/option"
          }
        },
        "best": {
          "enum": [
            "a",
            "b",
            "c",
            "d"
          ]
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "retired": {
          "type": "boolean"
        }
      },
      "if": {
        "properties": {
          "kind": {
            "const": "rule"
          }
        }
      },
      "then": {
        "properties": {
          "options": {
            "items": {
              "not": {
                "required": [
                  "tags"
                ]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "options": {
            "items": {
              "required": [
                "tags"
              ]
            }
          }
        }
      }
    }
  }
}

# VANDE Cricket — build-time configuration. Copy to .env.local (git-ignored) and fill in only what you use.
# Every value is OPTIONAL. With none set, `npm run build` produces an offline-capable app (Training and Practice
# Ghosts work; online modes show a clear "offline" state) that makes no network requests beyond its own files.
# Never put a secret here: everything in this file ends up in the public web and Android bundles.

# --- Game API (Cloudflare Worker; docs/INFRASTRUCTURE.md) ------------------------------------------------
# Production or staging Worker URL, e.g. https://api.vande.example
VITE_API_URL=
# '1' points the app at the local dev Worker (node backend/local/serve.mjs → http://127.0.0.1:8787).
VITE_API_LOCAL=
# Kill switch: '1' keeps the app offline-only even when a URL is set.
VITE_KILL_ONLINE=

# --- Links -----------------------------------------------------------------------------------------------
# Origin used in invite and highlight links (https://…); defaults to the page's own origin.
VITE_PUBLIC_WEB_ORIGIN=

# --- Platform features (disabled until configured) -------------------------------------------------------
# '1' enables FCM push through the native plugin (needs google-services.json in the Android project).
VITE_PUSH_ENABLED=
# Google sign-in for account linking and recovery (web OAuth client id; public, not a secret).
VITE_GOOGLE_CLIENT_ID=
# '1' enables passkeys (also needs the server verifier configured).
VITE_PASSKEYS=

# --- Product analytics (docs/ANALYTICS.md) ---------------------------------------------------------------
# 'none' (default) or 'posthog'. Analytics stay off until provider, host and key are all set.
VITE_ANALYTICS_PROVIDER=none
VITE_POSTHOG_HOST=
VITE_POSTHOG_KEY=
# Kill switch: '1' disables analytics even when configured.
VITE_KILL_ANALYTICS=

# --- Backend (backend/wrangler.toml [vars]; secrets via `wrangler secret put`, never in this file) ---------
# See backend/README.md and docs/INFRASTRUCTURE.md for RATE_SALT, TOKEN_KEYS, DATA_KEYS, SIGNING_KEY,
# IDENTITY_PEPPER and the YouTube/FCM credentials.

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "@cloudflare/workers-types"
    ],
    "resolveJsonModule": true,
    "paths": {
      "@/components/ui/Icon": [
        "./src/shims/icon.d.ts"
      ],
      "@/*": [
        "../src/*"
      ]
    }
  },
  "include": [
    "src",
    "test"
  ]
}

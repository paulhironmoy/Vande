    <string name="notif_opponent_locked_body">ನಿಮ್ಮ ಎದುರಾಳಿ ತಮ್ಮ ಯೋಜನೆಯನ್ನು ಲಾಕ್ ಮಾಡಿದ್ದಾರೆ. ಮುಂದುವರಿಯಲು ಪಂದ್ಯವನ್ನು ತೆರೆಯಿರಿ.</string>
    <string name="notif_reveal_ready_title">ರಿವೀಲ್ ಸಿದ್ಧ</string>
